generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Foundational key/value configuration store.
///
/// Phase 1 bootstrap only: this model exists to give the project a real,
/// reviewable first migration. Marketplace business tables (users, assets,
/// listings, auctions, orders, payments, escrow, ledger, ...) are added in
/// later phases — see docs/DATABASE_ARCHITECTURE.md.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// IDENTITY
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  PHONE_VERIFY
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  phone           String?      @unique
  passwordHash    String       @map("password_hash")
  status          UserStatus   @default(ACTIVE)
  roles           Role[]       @default([BUYER])
  adminRole       String?      @map("admin_role")
  emailVerifiedAt DateTime?    @map("email_verified_at")
  phoneVerifiedAt DateTime?    @map("phone_verified_at")
  locale          String       @default("en")
  defaultCountry  String?      @map("default_country") @db.Char(2)
  defaultCurrency String?      @map("default_currency") @db.Char(3)
  lastLoginAt     DateTime?    @map("last_login_at")
  version         Int          @default(0)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  sellerProfile     SellerProfile?
  buyerProfile      BuyerProfile?
  refreshTokens     RefreshToken[]
  verificationTokens VerificationToken[]
  bids              Bid[]
  offers            Offer[]
  watchlists        Watchlist[]

  @@index([status])
  @@map("users")
}

/// Hashed, rotating refresh tokens. Reuse of a rotated token revokes the whole
/// family (see IdentityService.refresh).
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id") @db.Uuid
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  userAgent     String?   @map("user_agent")
  ipHash        String?   @map("ip_hash")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Single-use tokens for email verification / password reset / phone verify.
model VerificationToken {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    VerificationPurpose
  tokenHash  String              @unique @map("token_hash")
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// SELLERS & TIERS
// ---------------------------------------------------------------------------

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PayoutAccountStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Tier definitions are CONFIGURATION ROWS, not code constants.
/// The API resolves limits/fees through these rows (see PlanPolicy in @fa/domain).
model SellerTier {
  code               String   @id // FREE_CODER | PRO_CODER | CORPORATE_SELLER
  name               String
  storageQuotaBytes  BigInt?  @map("storage_quota_bytes") // null = unlimited
  maxUploadBytesPerFile BigInt @map("max_upload_bytes_per_file")
  maxActiveListings  Int?     @map("max_active_listings") // null = unlimited
  commissionBps      Int      @map("commission_bps") // basis points, 1500 = 15.00%
  qualityQueue       String   @map("quality_queue") // standard | priority
  verificationLevel  String   @map("verification_level") // basic | enhanced | enterprise
  features           Json     @default("{}")
  effectiveFrom      DateTime @default(now()) @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  sellers SellerProfile[]

  @@map("seller_tiers")
}

model SellerProfile {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  displayName    String       @map("display_name")
  country        String       @db.Char(2)
  tierCode       String       @map("tier_code")
  status         SellerStatus @default(PENDING)
  ratingCount    Int          @default(0) @map("rating_count")
  ratingAvgBp    Int          @default(0) @map("rating_avg_bp") // avg rating * 100
  payoutCurrency String?      @map("payout_currency") @db.Char(3)
  verifiedAt     DateTime?    @map("verified_at")
  version        Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           SellerTier      @relation(fields: [tierCode], references: [code])
  payoutAccounts PayoutAccount[]
  digitalAssets  DigitalAsset[]
  listings       Listing[]
  cases          VerificationCase[]

  @@index([tierCode])
  @@index([status])
  @@map("seller_profiles")
}

model PayoutAccount {
  id              String              @id @default(uuid()) @db.Uuid
  sellerId        String              @map("seller_id") @db.Uuid
  provider        String
  accountRefEnc   String              @map("account_ref_enc") // AES-256-GCM ciphertext (never plaintext)
  accountRefLast4 String?             @map("account_ref_last4")
  country         String              @db.Char(2)
  currency        String              @db.Char(3)
  status          PayoutAccountStatus @default(PENDING)
  verifiedAt      DateTime?           @map("verified_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("payout_accounts")
}

model BuyerProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  defaultCountry  String?  @map("default_country") @db.Char(2)
  defaultCurrency String?  @map("default_currency") @db.Char(3)
  kycStatus       String   @default("NONE") @map("kyc_status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

// ---------------------------------------------------------------------------
// CROSS-CUTTING (audit + idempotency)
// ---------------------------------------------------------------------------

/// Append-only compliance trail. Never updated or deleted.
model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorId    String?        @map("actor_id") @db.Uuid
  actorType  AuditActorType @map("actor_type")
  action     String
  entityType String         @map("entity_type")
  entityId   String?        @map("entity_id")
  before     Json?
  after      Json?
  ipHash     String?        @map("ip_hash")
  userAgent  String?        @map("user_agent")
  requestId  String?        @map("request_id")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Client retry safety: replaying a request with the same (scope, key) returns
/// the stored response instead of re-executing the mutation.
model IdempotencyKey {
  id           String    @id @default(uuid()) @db.Uuid
  scope        String
  key          String
  requestHash  String    @map("request_hash")
  statusCode   Int?      @map("status_code")
  responseJson Json?     @map("response_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime? @map("expires_at")

  @@unique([scope, key])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// AUCTIONS · BIDS · OFFERS · WATCHLISTS
// ---------------------------------------------------------------------------

enum AuctionStatus {
  LIVE
  CLOSED
  RESERVE_MET
  RESERVE_NOT_MET
  COMPLETED
  CANCELLED
}

enum BidStatus {
  PLACED
  WON
  OUTBID
  WITHDRAWN
  INVALID
}

enum OfferStatus {
  PLACED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

/// Derived from an AUCTION-mode listing when it is approved (made ACTIVE).
/// Row-level locking (`SELECT ... FOR UPDATE`) serialises concurrent bids.
model Auction {
  id               String        @id @default(uuid()) @db.Uuid
  listingId        String        @unique @map("listing_id") @db.Uuid
  status           AuctionStatus @default(LIVE)
  /// Plain scalar (not a relation) to avoid a circular FK with Bid.
  currentBidId     String?       @map("current_bid_id") @db.Uuid
  currentBidMinor  BigInt?       @map("current_bid_minor")
  reserveMinor     BigInt?       @map("reserve_minor")
  bidCount         Int           @default(0) @map("bid_count")
  endsAt           DateTime      @map("ends_at")
  winnerBuyerId    String?       @map("winner_buyer_id") @db.Uuid
  openedAt         DateTime      @default(now()) @map("opened_at")
  closedAt         DateTime?     @map("closed_at")
  lastBidAt        DateTime?     @map("last_bid_at")
  version          Int           @default(0)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bids    Bid[]

  @@index([status, endsAt])
  @@map("auctions")
}

model Bid {
  id             String    @id @default(uuid()) @db.Uuid
  auctionId      String    @map("auction_id") @db.Uuid
  bidderId       String    @map("bidder_id") @db.Uuid
  amountMinor    BigInt    @map("amount_minor")
  currency       String    @db.Char(3)
  status         BidStatus @default(PLACED)
  placedAt       DateTime  @default(now()) @map("placed_at")
  ipHash         String?   @map("ip_hash")
  idempotencyKey String?   @map("idempotency_key")

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@unique([auctionId, idempotencyKey])
  @@index([auctionId, placedAt])
  @@map("bids")
}

model Offer {
  id             String      @id @default(uuid()) @db.Uuid
  listingId      String      @map("listing_id") @db.Uuid
  buyerId        String      @map("buyer_id") @db.Uuid
  amountMinor    BigInt      @map("amount_minor")
  currency       String      @db.Char(3)
  status         OfferStatus @default(PLACED)
  expiresAt      DateTime?   @map("expires_at")
  decisionReason String?     @map("decision_reason")
  idempotencyKey String?     @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([listingId, idempotencyKey])
  @@index([listingId, status])
  @@index([buyerId, status])
  @@map("offers")
}

model Watchlist {
  id        String   @id @default(uuid()) @db.Uuid
  buyerId   String   @map("buyer_id") @db.Uuid
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buyer User             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@unique([buyerId, name])
  @@index([buyerId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String   @id @default(uuid()) @db.Uuid
  watchlistId String   @map("watchlist_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  watchlist Watchlist    @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  asset     DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, assetId])
  @@map("watchlist_items")
}

// ---------------------------------------------------------------------------
// MARKETPLACE LISTINGS (fixed-price / classified)
// ---------------------------------------------------------------------------

enum ListingMode {
  FIXED_PRICE
  AUCTION
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SOLD
  PAUSED
  EXPIRED
  WITHDRAWN
}

model Listing {
  id             String        @id @default(uuid()) @db.Uuid
  assetId        String        @map("asset_id") @db.Uuid
  sellerId       String        @map("seller_id") @db.Uuid
  mode           ListingMode   @default(FIXED_PRICE)
  status         ListingStatus @default(DRAFT)
  priceMinor     BigInt?       @map("price_minor")
  currency       String?       @db.Char(3)
  startsAt       DateTime?     @map("starts_at")
  endsAt         DateTime?     @map("ends_at")
  publishedAt    DateTime?     @map("published_at")
  featuredUntil  DateTime?     @map("featured_until")
  rejectionReason String?      @map("rejection_reason")
  version        Int           @default(0)
  idempotencyKey String?       @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  asset       DigitalAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  attachments ListingAttachment[]
  auction     Auction?
  offers      Offer[]

  @@index([sellerId])
  @@index([assetId])
  @@index([status, endsAt])
  @@index([status, publishedAt])
  @@index([status, createdAt])
  @@index([status, priceMinor])
  @@index([status, featuredUntil])
  @@map("listings")
}

enum StorageObjectVisibility {
  PRIVATE
  REVIEW
  DOWNLOADS
}

enum StorageObjectScanStatus {
  PENDING
  CLEAN
  QUARANTINED
  ERROR
}

model StorageObject {
  id             String                  @id @default(uuid()) @db.Uuid
  bucket         String
  key            String
  ownerType      String                  @map("owner_type")
  ownerId        String                  @map("owner_id") @db.Uuid
  contentType    String                  @map("content_type")
  sizeBytes      BigInt                  @map("size_bytes")
  sha256         String?
  contentSha256  String?                 @map("content_sha256")
  visibility     StorageObjectVisibility @default(PRIVATE)
  scanStatus     StorageObjectScanStatus @default(PENDING) @map("scan_status")
  width          Int?
  height         Int?
  imageFormat    String?                 @map("image_format")
  retentionUntil DateTime?               @map("retention_until")
  createdAt      DateTime                @default(now()) @map("created_at")
  deletedAt      DateTime?               @map("deleted_at")

  listingAttachments ListingAttachment[]

  @@unique([bucket, key])
  @@index([ownerType, ownerId])
  @@index([scanStatus])
  @@map("storage_objects")
}

model ListingAttachment {
  id              String        @id @default(uuid()) @db.Uuid
  listingId       String        @map("listing_id") @db.Uuid
  storageObjectId String        @map("storage_object_id") @db.Uuid
  sort            Int           @default(0)
  caption         String?
  hero            Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at")

  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storageObject StorageObject @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)

  @@unique([listingId, storageObjectId])
  @@map("listing_attachments")
}

// ---------------------------------------------------------------------------
// QUALITY CONTROL (Phase 7)
// ---------------------------------------------------------------------------

enum QualityDecision {
  PASS
  REVIEW
  FAIL
}

enum ScannerRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// Versioned configuration. Thresholds are DATA, not code constants.
model QualityPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  version       Int      @unique
  name          String
  rules         Json
  isActive      Boolean  @default(false) @map("is_active")
  effectiveFrom DateTime @default(now()) @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  reports QualityReport[]

  @@index([isActive])
  @@map("quality_policies")
}

/// One executed scan. The RAW tool output is retained in object storage with
/// a sha256 for auditability (rule #15) — never re-derived, never deleted.
model ScannerRun {
  id             String           @id @default(uuid()) @db.Uuid
  assetId        String           @map("asset_id") @db.Uuid
  scanner        String
  scannerKind    String           @map("scanner_kind")
  scannerVersion String?          @map("scanner_version")
  status         ScannerRunStatus @default(COMPLETED)
  /// Storage keys of the scanned objects (bounded at scan time).
  targetObjectIds Json?
  /// Object-storage key of the raw tool output.
  rawResultObject String?         @map("raw_result_object")
  rawSha256       String?          @map("raw_sha256")
  error           String?
  exitCode        Int?             @map("exit_code")
  durationMs      Int?             @map("duration_ms")
  findingsCount   Int              @default(0) @map("findings_count")
  submittedAt     DateTime         @default(now()) @map("submitted_at")
  completedAt     DateTime?        @map("completed_at")

  findings SecurityFinding[]
  asset    DigitalAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, submittedAt])
  @@map("scanner_runs")
}

model SecurityFinding {
  id             String         @id @default(uuid()) @db.Uuid
  scannerRunId   String         @map("scanner_run_id") @db.Uuid
  scanner        String
  ruleId         String         @map("rule_id")
  severity       FindingSeverity
  category       String
  filePath       String?        @map("file_path")
  line           Int?
  title          String
  description    String
  /// ALREADY REDACTED before persistence — secrets never land in the DB.
  evidence       String?
  remediation    String?
  fingerprint    String
  createdAt      DateTime       @default(now()) @map("created_at")

  run ScannerRun @relation(fields: [scannerRunId], references: [id], onDelete: Cascade)

  @@unique([scannerRunId, fingerprint])
  @@index([severity])
  @@index([fingerprint])
  @@map("security_findings")
}

model QualityReport {
  id              String           @id @default(uuid()) @db.Uuid
  assetId         String           @map("asset_id") @db.Uuid
  policyId        String           @map("policy_id") @db.Uuid
  policyVersion   Int              @map("policy_version")
  decision        QualityDecision
  passCount       Int              @default(0) @map("pass_count")
  reviewCount     Int              @default(0) @map("review_count")
  failCount       Int              @default(0) @map("fail_count")
  totalFindings   Int              @default(0) @map("total_findings")
  highestSeverity FindingSeverity? @map("highest_severity")
  scannerRunIds   Json             @default("[]") @map("scanner_run_ids")
  computedAt      DateTime         @default(now()) @map("computed_at")

  asset  DigitalAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  policy QualityPolicy @relation(fields: [policyId], references: [id])

  @@index([assetId, computedAt])
  @@map("quality_reports")
}

// ---------------------------------------------------------------------------
// CATALOG (digital asset abstraction)
// ---------------------------------------------------------------------------

/// Common asset kinds. ONE `digital_assets` table + typed 1:1 metadata tables —
/// never an unrelated schema per asset type (see docs/adr/0001).
// ---------------------------------------------------------------------------
// VERIFICATION (Phase 8)
//
// VerificationCase is the workflow aggregate. The derived projection
// DigitalAsset.verificationStatus is updated ONLY by this module — never by
// clients. KYC answers reuse the same aggregate (targetType SELLER) so the
// admin queue, audit trail, and expiry semantics stay uniform.
// ---------------------------------------------------------------------------

enum VerificationTargetType {
  ASSET
  SELLER
}

enum VerificationCaseStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum VerificationMethod {
  DNS_TXT
  HTTP_TOKEN
  SOCIAL_PROOF
  STORE_PROOF
  MANUAL
}

enum KycLevel {
  BASIC
  ENHANCED
  ENTERPRISE
}

/// One workflow per asset-or-seller verification. Only one OPEN/SUBMITTED
/// case may exist per asset (partial-unique index) to prevent queue spam.
model VerificationCase {
  id           String                  @id @default(uuid()) @db.Uuid
  targetType   VerificationTargetType  @map("target_type")
  assetId      String?                 @map("asset_id") @db.Uuid
  sellerId     String?                 @map("seller_id") @db.Uuid
  method       VerificationMethod
  /// Tier-appropriate KYC bar for SELLER cases; null for ASSET cases.
  kycLevel     KycLevel?               @map("kyc_level")
  status       VerificationCaseStatus  @default(OPEN)
  /// Active DNS/HTTP challenge still awaiting proof (null once consumed).
  challengeId  String?                 @map("challenge_id") @db.Uuid
  attempts     Int                     @default(0)
  decidedById  String?                 @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?               @map("decided_at")
  decisionNote String?                 @map("decision_note")
  expiresAt    DateTime                @map("expires_at")
  version      Int                     @default(0)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  asset      DigitalAsset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  seller     SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  challenge  OwnershipChallenge? @relation("CaseChallenge", fields: [challengeId], references: [id], onDelete: SetNull)
  challenges OwnershipChallenge[] @relation("ChallengeCase")
  kycAnswers KycAnswer[]

  /// Exactly one target must be set (enforced in service + CHECK below).
  @@index([assetId, status])
  @@index([sellerId, status])
  @@index([status, expiresAt])
  @@index([challengeId])
  @@map("verification_cases")
}

/// Server-issued ownership challenge. The TOKEN is the secret — only its
/// sha256 is stored; the plaintext is shown to the seller exactly once at
/// issuance. Checks run server-side against live DNS/HTTP, never client claims.
model OwnershipChallenge {
  id          String             @id @default(uuid()) @db.Uuid
  caseId      String             @map("case_id") @db.Uuid
  method      VerificationMethod
  /// DNS label (TXT record name) or HTTP path — server-derived, not client input.
  target      String
  tokenHash   String             @map("token_hash")
  attempts    Int                @default(0)
  verifiedAt  DateTime?          @map("verified_at")
  expiresAt   DateTime           @map("expires_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  caseRecord VerificationCase @relation("ChallengeCase", fields: [caseId], references: [id], onDelete: Cascade)
  activeFor  VerificationCase[] @relation("CaseChallenge")

  @@index([caseId])
  @@index([expiresAt])
  @@map("ownership_challenges")
}

/// Structured KYC answers attached to a SELLER VerificationCase. Document
/// IMAGES stay in private object storage — only the object id is referenced
/// here; the ciphertext holds PII and is AES-256-GCM encrypted.
model KycAnswer {
  id              String   @id @default(uuid()) @db.Uuid
  caseId          String   @map("case_id") @db.Uuid
  question        String
  /// Encrypted answer payload (FieldCipher). Last-4 style hints stay in `hint`.
  answerEnc       String   @map("answer_enc")
  hint            String?
  /// Private StorageObject id for document uploads (never a public URL).
  evidenceObjectId String? @map("evidence_object_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  caseRecord VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("kyc_answers")
}

enum AssetType {
  SOFTWARE
  WEBSITE
  MOBILE_APP
  YOUTUBE_CHANNEL
  INSTAGRAM_PROFILE
  GAME_ACCOUNT
  DOMAIN
  OTHER
}

/// Lifecycle of the asset RECORD itself (listing lifecycle lives on `listings`).
enum AssetStatus {
  DRAFT
  READY
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum QualityStatus {
  PENDING
  PASS
  REVIEW
  FAIL
}

model Category {
  id         String      @id @default(uuid()) @db.Uuid
  parentId   String?     @map("parent_id") @db.Uuid
  slug       String      @unique
  name       String
  assetTypes AssetType[] @map("asset_types")
  sort       Int         @default(0)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  parent   Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]     @relation("CategoryTree")
  assets   DigitalAsset[]

  @@index([parentId])
  @@map("categories")
}

model DigitalAsset {
  id                 String             @id @default(uuid()) @db.Uuid
  type               AssetType
  slug               String             @unique
  title              String
  summary            String?
  sellerId           String             @map("seller_id") @db.Uuid
  country            String             @db.Char(2)
  currency           String             @db.Char(3)
  categoryId         String?            @map("category_id") @db.Uuid
  status             AssetStatus        @default(DRAFT)
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  qualityStatus      QualityStatus      @default(PENDING) @map("quality_status")
  /// Long-tail, type-specific extras that do not warrant a column (validated per type).
  extra              Json               @default("{}")
  version            Int                @default(0)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  seller    SellerProfile       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category  Category?           @relation(fields: [categoryId], references: [id])
  listings  Listing[]
  cases     VerificationCase[]
  software  SoftwareMetadata?
  website   WebsiteMetadata?
  mobile    MobileAppMetadata?
  youtube   YouTubeMetadata?
  instagram InstagramMetadata?
  game      GameAccountMetadata?
  domain    DomainMetadata?
  watchlistItems WatchlistItem[]
  scannerRuns    ScannerRun[]
  qualityReports QualityReport[]

  @@index([sellerId])
  @@index([type, status])
  @@index([categoryId])
  @@index([country])
  @@index([verificationStatus, qualityStatus])
  @@map("digital_assets")
}

// --- Type-specific metadata (1:1 with digital_assets) ----------------------

model SoftwareMetadata {
  assetId            String   @id @map("asset_id") @db.Uuid
  language           String?
  framework          String?
  runtime            String?
  sourceRepo         String?  @map("source_repo")
  packageSizeBytes   BigInt   @map("package_size_bytes")
  dependencyCount    Int      @default(0) @map("dependency_count")
  licenseSpdx        String?  @map("license_spdx")
  /// Scanner output (Phase 7) — never client-supplied.
  licenseFindingsJson Json    @default("[]") @map("license_findings_json")
  securityFindingsJson Json   @default("[]") @map("security_findings_json")
  qualityScore       Int?     @map("quality_score")

  asset DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_metadata_software")
}

model WebsiteMetadata {
  assetId              String   @id @map("asset_id") @db.Uuid
  domain               String
  monthlyTraffic       Int?     @map("monthly_traffic")
  technology           Json     @default("[]")
  hosting              String?
  monthlyRevenueMinor  BigInt?  @map("monthly_revenue_minor")
  revenueCurrency      String?  @map("revenue_currency") @db.Char(3)
  /// Set by ownership/analytics verification (Phase 8) — never client-supplied.
  analyticsVerified    Boolean  @default(false) @map("analytics_verified")
  analyticsProvider    String?  @map("analytics_provider")

  asset DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_metadata_website")
}

model MobileAppMetadata {
  assetId              String   @id @map("asset_id") @db.Uuid
  platforms            Json     @default("[]")
  bundleId             String?  @map("bundle_id")
  storeLinks           Json     @default("[]") @map("store_links")
  installs             Int?
  monthlyRevenueMinor  BigInt?  @map("monthly_revenue_minor")
  revenueCurrency      String?  @map("revenue_currency") @db.Char(3)
  appVersion           String?  @map("app_version")

  asset DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_metadata_mobile")
}

model YouTubeMetadata {
  assetId              String   @id @map("asset_id") @db.Uuid
  channelId            String   @map("channel_id")
  subscribers          Int?
  totalViews           BigInt?  @map("total_views")
  videoCount           Int?     @map("video_count")
  channelAgeDays       Int?     @map("channel_age_days")
  monetized            Boolean  @default(false)
  monthlyRevenueMinor  BigInt?  @map("monthly_revenue_minor")
  revenueCurrency      String?  @map("revenue_currency") @db.Char(3)
  /// Retained provider snapshot (Phase 8) — never client-supplied.
  snapshotId           String?  @map("snapshot_id") @db.Uuid

  asset DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_metadata_youtube")
}

model InstagramMetadata {
  assetId         String   @id @map("asset_id") @db.Uuid
  accountId       String   @map("account_id")
  followers       Int?
  engagementBps   Int?     @map("engagement_bps")
  mediaCount      Int?     @map("media_count")
  accountAgeDays  Int?     @map("account_age_days")
  snapshotId      String?  @map("snapshot_id") @db.Uuid

  asset DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_metadata_instagram")
}

model GameAccountMetadata {
  assetId      String   @id @map("asset_id") @db.Uuid
  game         String
  platform     String
  accountRef   String   @map("account_ref")
  levelRank    String?  @map("level_rank")
  inventory    Json     @default("[]")
  banState     String   @default("CLEAR") @map("ban_state")
  transferable Boolean  @default(true)

  asset DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_metadata_game")
}

model DomainMetadata {
  assetId        String    @id @map("asset_id") @db.Uuid
  domainName     String    @map("domain_name")
  registrar      String?
  expiresAt      DateTime? @map("expires_at")
  transferLocked Boolean   @default(false) @map("transfer_locked")
  dns            Json      @default("[]")

  asset DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_metadata_domain")
}

/// Retained third-party snapshots (YouTube/Instagram/gaming) for auditability.
model SocialSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  subjectRef String   @map("subject_ref")
  raw        Json
  sha256     String
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@index([provider, subjectRef])
  @@map("social_snapshots")
}
