# syntax=docker/dockerfile:1
# Baseline API image (Phase 1). Hardened/multi-stage-optimized in Phase 16.
FROM node:22-alpine AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @fa/domain build \
 && pnpm --filter @fa/contracts build \
 && pnpm --filter @fa/config build \
 && pnpm --filter @fa/api build

FROM node:22-alpine AS runtime
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NODE_ENV=production
RUN corepack enable
WORKDIR /repo
COPY --from=build /repo /repo
EXPOSE 4000
CMD ["pnpm", "--filter", "@fa/api", "start"]
