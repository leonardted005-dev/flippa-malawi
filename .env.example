# ---------------------------------------------------------------------------
# Environment configuration — copy to `.env` and fill in.
# NEVER commit a real `.env`. Secrets live in the deploy secret manager.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://fa:fa@localhost:5432/flippa_africa?schema=public
SHADOW_DATABASE_URL=postgresql://fa:fa@localhost:5432/flippa_africa_shadow?schema=public

# --- Cache / queues (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Auth (change in every non-local environment) ---
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=2592000
# Base64 key material (>=32 bytes decoded) for AES-256-GCM field encryption.
FIELD_ENCRYPTION_KEY=dev-only-field-encryption-key-change-me-32b

# --- Object storage (S3-compatible: Cloudflare R2 / Backblaze B2 / Supabase) ---
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=fa-private
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL=900

# --- Payments: DPO Pay ---
# NOTE: DPO-specific request/response FIELDS are intentionally NOT defined here
# until the official DPO merchant integration specification is provided
# (audit rule #18). Only provider-agnostic config keys may be added for now.
PAYMENTS_DEFAULT_PROVIDER=dpo
DPO_ENV=sandbox
DPO_MERCHANT_ID=TODO-from-dpo-spec
DPO_API_KEY=TODO-from-dpo-spec
DPO_API_SECRET=TODO-from-dpo-spec
DPO_WEBHOOK_SECRET=TODO-from-dpo-spec

# --- Quality / scanners (Phase 7) ---
# Relative paths resolve from the API's working directory (apps/api).
# Fetch with: node scripts/fetch-scanners.mjs
SCANNERS_GITLEAKS_BIN=../../tools/gitleaks.exe
